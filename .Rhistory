# Helper: fit linear trend per scenario and format significance labels
make_trend_labels <- function(data, y_positions) {
data |>
group_nest(scenario) |>
mutate(model = map(data, ~ lm(value ~ date, data = .) |> broom::tidy())) |>
select(-data) |>
unnest(model) |>
filter(term == "date") |>
mutate(
x        = y_positions$x,
y        = y_positions$y,
p.value  = round(p.value, 5),
psymble  = case_when(
p.value < 0.001 ~ "***",
p.value < 0.01  ~ "**",
p.value < 0.05  ~ "*",
TRUE            ~ ""
),
statistic = round(statistic, 2),
label     = str_c(scenario, ": ", statistic, psymble)
)
}
# --- Negative extremes (10th percentile) ---
ext_neg_data <- ext_nospace_zone |>
filter(var == "npp", magnitude == "tenth") |>
summarise(error = sd(value), value = mean(value),
.by = c(scenario, var, date, magnitude))
ext_neg_sig <- make_trend_labels(
ext_neg_data,
list(x = c(2035, 2035, 2055, 2055), y = c(-78, -84, -78, -84))
)
p_ext_neg_ts <- ext_neg_data |>
ggplot(aes(x = date, y = value)) +
geom_text(
data = ext_neg_sig,
aes(x = x, y = y - 30, label = label, col = scenario),
family = "serif", size = 3, show.legend = FALSE
) +
geom_ribbon(aes(ymin = value - error, ymax = value + error, fill = scenario),
alpha = 0.2, show.legend = FALSE) +
geom_line(aes(col = scenario)) +
geom_smooth(method = "lm", se = FALSE, aes(col = scenario), linewidth = 0.5) +
labs(y = expression("NPP gC" ~ m^-2 ~ yr^-1), col = "", x = "") +
theme_bw() +
theme(legend.position = "top")
# --- Positive extremes (90th percentile) ---
