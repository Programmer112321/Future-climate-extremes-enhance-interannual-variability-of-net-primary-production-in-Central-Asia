mutate(type = "mean") |>
bind_rows(trend_nomodel_frame |> mutate(type = "trend")) |>
bind_rows(sd_nomodel_frame    |> mutate(type = "sd"))    |>
select(-label)                                           |>
group_nest(type, var)                                    |>
mutate(bound = list(sf::st_as_sf(climatebound)))         |>
add_unit()                                               |>
mutate(
unit = ifelse(
var == "npp" & type == "trend",
list(expression(NPP ~ gC ~ m^-2 ~ yr^-2)),
unit
)
)
# Generate one raster map per type × variable combination
basic_space_plot <- pmap(
list(basic_space$data, basic_space$bound, basic_space$unit),
~ ggplot() +
geom_raster(data = ..1, aes(x = x, y = y, fill = mean)) +
geom_sf(data = ..2, fill = alpha(0.01)) +
geom_sf_text(aes(label = value), size = 4, data = ..2) +
coord_sf() +
scale_fill_gradientn(
colours = colorRampPalette(
c("#ffffcc", "#c7e9b4", "#7fcdbb", "#41b6c4", "#1d91c0", "#225ea8", "#0c2c84")
)(200)
) +
labs(fill = ..3, x = "", y = "") +
theme_bw() +
spatial_theme +
facet_wrap(. ~ scenario)
)
