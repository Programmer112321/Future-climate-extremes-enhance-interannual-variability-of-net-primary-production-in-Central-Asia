# Shared bar plot theme elements
bar_theme <- list(
theme_bw(),
theme(
legend.position    = "top",
strip.background   = element_blank(),
strip.placement    = "outside",
axis.text.y        = element_text(angle = 90),
axis.ticks.length.y = unit(-0.1, "cm"),
strip.text.y       = element_text(size = rel(1.1)),
plot.background    = element_rect(fill = "transparent", color = NA),
panel.background   = element_rect(fill = "transparent", color = NA),
legend.background  = element_rect(fill = "transparent", color = NA)
)
)
make_extreme_bar <- function(data, y_var, y_label) {
ggplot(
data |>
filter(var == "npp") |>
extmodify() |>
mutate(magnitude = factor(magnitude, levels = c("ninetieth", "tenth"))),
aes(x = region, y = {{ y_var }}, fill = scenario, color = scenario)
) +
stat_summary(
fun.min  = \(x) mean(x) - sd(x) / sqrt(length(x)),
fun.max  = \(x) mean(x) + sd(x) / sqrt(length(x)),
geom     = "errorbar",
position = position_dodge(width = 0.9), width = 0.9
) +
stat_summary(
fun      = mean,
geom     = "bar",
position = position_dodge(width = 0.9), width = 0.9
) +
facet_grid(
magnitude ~ .,
scales   = "free_y",
switch   = "y",
labeller = labeller(
magnitude = c(ninetieth = "Positive extremes", tenth = "Negative extremes")
)
) +
labs(x = NULL, y = y_label, fill = NULL, color = NULL) +
bar_theme
}
npp_magnitude <- make_extreme_bar(
ext_nodate_zone |> filter(index == "value"),
value,
expression(NPP ~ (TgC ~ yr^{-1}))
)
npp_average <- make_extreme_bar(
ext_nodate_zone |> filter(index == "value"),
value,
expression(NPP ~ (gC ~ m^{-2} ~ yr^{-1}))
)
npp_quantity <- make_extreme_bar(
ext_nodate_zone |> filter(index == "quantity"),
value,
"Number of NPP extreme years"
)
(npp_magnitude | npp_average | npp_quantity) +
plot_annotation(tag_levels = "a") +
plot_layout(guides = "collect") &
theme(legend.position = "top")
